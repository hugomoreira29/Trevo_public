# =============================================================================
# Trevo — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose — Service Ports
# -----------------------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8080
DB_PORT=5432

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=trevo
POSTGRES_USER=trevo
POSTGRES_PASSWORD=trevo123

# -----------------------------------------------------------------------------
# Backend (Spring Boot)
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/trevo
SPRING_DATASOURCE_USERNAME=trevo
SPRING_DATASOURCE_PASSWORD=trevo123

# JWT
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# Frontend (React + Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# HTTPS deployment (NFR-06)
# -----------------------------------------------------------------------------
# Used with:
#   docker compose -f docker-compose.yml -f docker-compose.https.yml up -d
#
# PUBLIC_DOMAIN must point to the deployment host through DNS before Caddy can
# issue Let's Encrypt certificates. Do not include https:// in this value.
# PUBLIC_DOMAIN=trevo.example.com
# ACME_EMAIL=admin@example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Cloudinary (image uploads)
# -----------------------------------------------------------------------------
# Copy this value from the Cloudinary Console for the shared Trevo project
# environment. Do not commit real credentials to the repository.
# Expected format:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# -----------------------------------------------------------------------------
# Stripe (payments — Phase 7)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# PayPal (payments — Phase 7)
# -----------------------------------------------------------------------------
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...

# -----------------------------------------------------------------------------
